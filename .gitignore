/*
!/src/
!/tests/
!/.gitignore
!/engine-wasm/
/engine-wasm/*
!/engine-wasm/src/
!/engine-wasm/Cargo.toml
!/engine-wasm/Cargo.lock
!/engine-wasm/.cargo/

/tests/build/local-compile/
# Transient diag artefacts (never commit)
/tests/tmp-*
*.log
/tmp-battery.log
# Build/test byproducts (regenerable)
/dist/
/engine-wasm/target/
/tests/build/
/firmware.bin
/wifi-capture.pcap
/node_modules/
# Gateway binaries (rebuild via `cd openhw-studio-gateway && go build`); keep sources
/openhw-studio-gateway/openhw-gw
/openhw-studio-gateway/openhw-gw.exe
/openhw-studio-gateway/ap_bridge.go.bak
!/.github/
!/docs/
!/README.md
!/package.json
!/LICENSE
!/CHANGELOG.md
!/THIRD-PARTY-NOTICES.md
!/bin
!/build.mjs
!/eslint.config.js
!/package-lock.json
# Project docs + handoff notes at root
!/AGENT.md
!/AGENTS.md
!/ble.md
!/handover.md
!/spi-rx-debug.mjs
!/tsconfig.json
# ESP32-CAM / gateway sources
!/openhw-studio-gateway/
!/openhw-studio-gateway/*.go
!/openhw-studio-gateway/go.mod
!/openhw-studio-gateway/go.sum
!/openhw-studio-gateway/README.md
!/openhw-studio-gateway/start-gateway.sh
!/openhw-studio-gateway/start-gateway.cmd
!/openhw-studio-gateway/Dockerfile
# Root rom symlink -> tests/rom (tracked); tests/rom/*.bin is real data
!/rom
# Webdemo site (static browser demo: pages + bundled worker + prebuilt firmware)
!/webdemo/
!/webdemo/*.html
!/webdemo/*.js
!/webdemo/*.css
!/webdemo/worker/
!/webdemo/worker/*.js
!/webdemo/firmware/
!/webdemo/firmware/*.gz
# Worker + ROM binaries are loaded by the webdemo from webdemo/worker/
!/webdemo/worker/*.wasm
!/webdemo/worker/*.bin
# Build tooling (webdemo bundler + node:crypto MD5 shim for the browser build)
!/tools/
!/tools/*.mjs
# Demo sketch sources shown by the webdemo "view sketch" modal
!/webdemo/sketches/
!/webdemo/sketches/*.ino
