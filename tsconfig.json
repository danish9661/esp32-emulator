{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "allowJs": true,
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/peripherals/common/memory.js",
    "src/peripherals/common/trace.js",
    "src/sab/worker-proxy.js"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "engine-wasm"
  ]
}
